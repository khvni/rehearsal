#cloud-config
package_update: true
packages:
  - git
  - curl
  - xz-utils
  - caddy
  - iptables

users:
  - default
  - name: rehearsal
    system: true
    shell: /bin/bash
    homedir: /opt/rehearsal

write_files:
  - path: /etc/systemd/system/rehearsal.service
    content: |
      [Unit]
      Description=Rehearsal (Next.js)
      After=network-online.target
      Wants=network-online.target

      [Service]
      User=rehearsal
      WorkingDirectory=/opt/rehearsal/app
      Environment=NODE_ENV=production
      # Written by Terraform over SSH after boot (terraform_data.app_env); never in user_data.
      # Required: the app never starts without it, so it is never up without REHEARSAL_ACCESS_TOKEN.
      EnvironmentFile=/etc/rehearsal/env
      # Defense in depth for SSRF: the app user can never reach link-local/metadata (169.254.0.0/16).
      ExecStartPre=+/bin/sh -c 'iptables -C OUTPUT -d 169.254.0.0/16 -m owner --uid-owner rehearsal -j REJECT 2>/dev/null || iptables -I OUTPUT -d 169.254.0.0/16 -m owner --uid-owner rehearsal -j REJECT'
      ExecStart=/usr/local/bin/npm start -- -H 127.0.0.1 -p 3000
      Restart=always

      [Install]
      WantedBy=multi-user.target
  - path: /etc/caddy/Caddyfile
    content: |
      ${site} {
        reverse_proxy 127.0.0.1:3000
      }

runcmd:
  - curl -fsSL https://nodejs.org/dist/v22.21.0/node-v22.21.0-linux-x64.tar.xz | tar -xJ --strip-components=1 -C /usr/local
  - mkdir -p /opt/rehearsal && chown rehearsal:rehearsal /opt/rehearsal
  - sudo -u rehearsal git clone --depth 1 https://github.com/${github_repo}.git /opt/rehearsal/app
  - cd /opt/rehearsal/app && sudo -u rehearsal git fetch --depth 1 origin ${git_ref} && sudo -u rehearsal git checkout FETCH_HEAD
  - cd /opt/rehearsal/app && sudo -u rehearsal -H npm ci
  - cd /opt/rehearsal/app && npx playwright install-deps chromium
  - cd /opt/rehearsal/app && sudo -u rehearsal -H npx playwright install chromium
  - cd /opt/rehearsal/app && sudo -u rehearsal -H npm run build
  - systemctl daemon-reload
  - systemctl enable rehearsal
  - systemctl restart caddy
