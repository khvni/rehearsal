{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehearsal-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "d1_databases": [
    { "binding": "DB", "database_name": "rehearsal-demo-db", "database_id": "890cad9a-61e1-48a5-a450-d6e157cd3e3f" }
  ],
  "routes": [
    { "pattern": "rehearsal.alikhani.co", "zone_name": "alikhani.co", "custom_domain": true }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rehearsal-demo" }],
  "observability": { "enabled": true },
  "vars": {
    "BROWSERBASE_FUNCTION_ID": "eb8a2fde-7dd4-4c0a-91e7-aa87117732ff",
    "REHEARSAL_BROWSER": "browserbase-function",
    "REHEARSAL_ORIGIN": "https://rehearsal.alikhani.co",
    "REHEARSAL_STEP_BUDGET_MS": "28000"
  }
}
