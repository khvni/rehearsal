{
  "name": "rehearsal",
  "version": "0.1.0",
  "private": true,
  "description": "Rehearse your website before users do. Simulate journeys, verify in real browsers, ship a rebuild spec.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "eval": "vitest run tests/evals --reporter=dot",
    "test:e2e": "playwright test",
    "check:skill-sync": "tsx scripts/check-skill-sync.ts",
    "check:facts": "tsx scripts/verify-facts.ts",
    "design:check": "sh .devin/skills/impeccable/scripts/impeccable detect src/app",
    "spec:delta": "tsx scripts/spec-delta.ts",
    "site": "tsx scripts/run-site.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run eval && npm run check:skill-sync && npm run check:facts",
    "factory:sync": "tsx scripts/factory-sync.ts",
    "factory:check": "tsx scripts/factory-sync.ts --check"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.4.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.25.0",
    "@types/pg": "^8.23.1",
    "@xyflow/react": "^12.9.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "^16.0.3",
    "pg": "^8.23.1",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.162.0"
  }
}
