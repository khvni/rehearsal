{
  "name": "rehearsal",
  "version": "0.1.0",
  "private": true,
  "description": "Rehearse your website before users do. Simulate journeys, verify in real browsers, ship a rebuild spec.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "eval": "vitest run tests/evals --reporter=dot",
    "test:e2e": "playwright test",
    "functions:dev": "cd functions/rehearsal-browser && browse functions dev index.ts",
    "functions:publish": "cd functions/rehearsal-browser && browse functions publish index.ts",
    "functions:sync": "tsx scripts/sync-function-lib.ts",
    "check:function-lib": "tsx scripts/sync-function-lib.ts --check",
    "check:skill-sync": "tsx scripts/check-skill-sync.ts",
    "check:facts": "tsx scripts/verify-facts.ts",
    "design:check": "sh .devin/skills/impeccable/scripts/impeccable detect src/app",
    "design:check:rebuild": "tsx scripts/check-rebuild-design.ts",
    "spec:delta": "tsx scripts/spec-delta.ts",
    "bench": "tsx scripts/bench.ts",
    "site": "tsx scripts/run-site.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run eval && npm run check:skill-sync && npm run check:function-lib && npm run check:facts",
    "postinstall": "lefthook install",
    "factory:sync": "tsx scripts/factory-sync.ts",
    "factory:check": "tsx scripts/factory-sync.ts --check"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.4.0",
    "@cloudflare/sandbox": "^1.0.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.12.0",
    "@types/pg": "^8.23.1",
    "@xyflow/react": "^12.9.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "entities": "^7.0.1",
    "htmlparser2": "^10.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "^16.0.3",
    "pg": "^8.23.1",
    "playwright": "^1.56.1",
    "posthog-js": "^1.449.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@browserbasehq/sdk-functions": "^1.0.3",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "^14.0.2"
    },
    "archiver-utils": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
