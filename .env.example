# Rehearsal integrations — every adapter no-ops without its keys.
# The full pipeline runs offline on recorded fixtures.

# Gemini (required for live analysis; hydrogen = cheap structured calls, argon = findings/spec)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_DEEP=gemini-4-argon
# Max Gemini calls per experiment run (a run makes up to 5); extra calls use the deterministic fallback.
REHEARSAL_GEMINI_MAX_CALLS=2

# Jev / System One decision model (OpenRouter decisions API or compatible base URL)
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_API_KEY=
OPENROUTER_API_KEY=

# Bright Data Web Unlocker — page fetch (POST https://api.brightdata.com/request)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Bright Data Browser API (Scraping Browser) — state capture over CDP, one fresh session per page.
# Either the full endpoint: wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222
BRIGHTDATA_BROWSER_WS=
# ...or the zone credentials (the wss URL is built for you)
BRIGHTDATA_BROWSER_USER=
BRIGHTDATA_BROWSER_PASSWORD=

# Browserbase + Stagehand v4 — multi-step trajectories (act/observe, self-healing selectors),
# and Browserbase Fetch as the second page-fetch option.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Stagehand model for act(): "<provider>/<model>" (openai|anthropic|google|groq|cerebras).
# Unset: reuses GEMINI_API_KEY as google/$GEMINI_MODEL_FAST, else Browserbase Model Gateway.
STAGEHAND_MODEL=
STAGEHAND_MODEL_API_KEY=
# Chrome binary for REHEARSAL_BROWSER=stagehand-local (e.g. npx playwright install chromium path)
STAGEHAND_CHROME_PATH=

# Force a browser backend: auto (default) | brightdata | stagehand | stagehand-local | playwright
REHEARSAL_BROWSER=auto

# Sentry — server-side errors + stage traces (no client SDK is wired)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Tiger Data (Postgres/TimescaleDB) — experiment persistence
DATABASE_URL=
TIGERDATA_URL=

# Snowflake Cortex Search — knowledge base over past findings (optional)
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_TOKEN=
SNOWFLAKE_CORTEX_SERVICE=

# Pipeline budgets are per experiment, not env: POST /api/experiments {config: {maxStates,
# maxDepth, trajectories, verifyCount, seed, viewports}} — see docs/api.md.

# Tests/local fixtures only: skips the SSRF guard's private-address check. Never deploy it.
# REHEARSAL_ALLOW_PRIVATE=1
