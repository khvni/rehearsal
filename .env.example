# Whole-site rebuild planner (180s per call); implementer uses OPENROUTER_MODEL_REBUILD (90s).
OPENROUTER_MODEL_REBUILD_PLANNER=anthropic/claude-opus-5.5
REHEARSAL_REBUILD_MAX_PAGES=40
# Rehearsal integrations — every adapter no-ops without its keys.
# The full pipeline runs offline on recorded fixtures.

# Gemini (required for live analysis; hydrogen = cheap structured calls, argon = findings/spec)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_DEEP=gemini-4-argon
# Frontier generation model for spec-stage mockup pages; defaults to GEMINI_MODEL_DEEP,
# falls back to GEMINI_MODEL_FAST on quota/5xx errors.
GEMINI_MODEL_MOCKUP=gemini-4-argon
# Max Gemini calls per experiment run (a run makes up to 6); extra calls use the deterministic fallback.
REHEARSAL_GEMINI_MAX_CALLS=10
# OpenRouter (OpenAI-compatible chat completions). When OPENROUTER_API_KEY (below) is set, every LLM stage uses it instead of Gemini.
OPENROUTER_MODEL_FAST=google/gemini-4-hydrogen
OPENROUTER_MODEL_DEEP=google/gemini-4-argon
OPENROUTER_MODEL_MOCKUP=google/gemini-4-argon
# Rebuild pages are a layout POC, so they get a cheaper model.
OPENROUTER_MODEL_REBUILD=google/gemini-3.8-flash

# Jev / System One decision model (TypeSafe System One API; only JEV_API_KEY is sent to it)
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
OPENROUTER_API_KEY=

# Browserbase + Stagehand v4 — all remote browser work runs in the published rehearsal-browser
# Function (see functions/rehearsal-browser). The Function id is public; the key/id are secrets.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_FUNCTION_ID=
# Optional: reuse a pre-uploaded Stagehand extension (also overrides the Function's pinned id)
BROWSERBASE_EXTENSION_ID=

# Firecrawl — hosted discovery fallback for JS-heavy pages. Plain fetch tries first;
# a page that looks like a JS shell retries via /v1/scrape, and a seed page with few
# links gets one /v1/map expansion (cap: config.firecrawlMapLimit). Unset = fetch-only.
FIRECRAWL_API_KEY=
# Stagehand model for act(): "<provider>/<model>" (openai|anthropic|google|groq|cerebras).
# Unset: reuses GEMINI_API_KEY as google/$GEMINI_MODEL_FAST, else Browserbase Model Gateway.
STAGEHAND_MODEL=
STAGEHAND_MODEL_API_KEY=
# Chrome binary for REHEARSAL_BROWSER=stagehand-local (e.g. npx playwright install chromium path)
STAGEHAND_CHROME_PATH=

# Force a browser backend: auto (default; discover crawls via plain fetch + Firecrawl
# fallback) | browserbase-function | stagehand | stagehand-local | playwright
REHEARSAL_BROWSER=auto
# Opt-in: run the verify stage as an agent loop (observe/act/extract) instead of scripted
# locators. Only fires when the selected runner supports it (Stagehand + a model).
REHEARSAL_VERIFY_AGENT=
# Code sandbox for agent-generated test code: auto (default) | node | cloudflare.
# auto → Cloudflare Sandbox when the Sandbox binding exists, else an isolated node worker.
REHEARSAL_SANDBOX=auto
# Local Chromium (Playwright + stagehand-local) runs sandboxed. Set 1 only on hosts without
# unprivileged user namespaces; never in a deployment.
# REHEARSAL_CHROMIUM_NO_SANDBOX=

# Sentry — server-side errors + stage traces (no client SDK is wired)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Sentry internal integration client secret: verifies POST /api/hooks/sentry (unset => 503)
SENTRY_WEBHOOK_SECRET=
# GitHub token with issues:write on khvni/rehearsal: the Sentry hook files first-responder issues (unset => logged no-op)
GITHUB_TOKEN=

# Tiger Data (Postgres/TimescaleDB) — experiment persistence
DATABASE_URL=
TIGERDATA_URL=

# PostHog web analytics + session replay (client-side, baked at build; defaults match alikhani.co)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Snowflake Cortex Search — knowledge base over past findings (optional)
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_TOKEN=
SNOWFLAKE_CORTEX_SERVICE=

# Pipeline budgets are per experiment, not env: POST /api/experiments {config: {maxStates,
# maxDepth, trajectories, verifyCount, seed, viewports}} — see docs/api.md.

# Shared secret for every page and API route (Basic-auth password with any username, or
# `Authorization: Bearer <token>`). Unset = no gate (local dev). Set it on any public host.
REHEARSAL_ACCESS_TOKEN=
# Pipeline stage requests allowed to run at once in this process; extras get 429.
REHEARSAL_MAX_CONCURRENT_RUNS=2
# Optional extra auth for POST /api/internal/run-step — the per-run token is enough on its own; set this to also require a shared bearer secret.
# REHEARSAL_RUN_SECRET=
# Run-step slice budget (ms) and stall watchdog window (ms) for chunked background runs on Workers.
# REHEARSAL_STEP_BUDGET_MS=20000
# REHEARSAL_STALL_MS=180000
# Pin run-step continuation hops to this origin — set it on public hosts so a
# spoofed Host header can't carry the per-run token elsewhere (e.g. https://rehearsal.example.com).
# REHEARSAL_ORIGIN=

# Tests/local fixtures only: skips the SSRF guard's private-address check. Never deploy it.
# REHEARSAL_ALLOW_PRIVATE=1
